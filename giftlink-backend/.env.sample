# Local replica set; see README for guarded index preparation before startup.
# Pickup timezone is selected explicitly on each plan, never inferred from TZ/env.
MONGO_URL=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_DB_NAME=giftdb
# Explicit administration tier; independent of NODE_ENV's cookie/runtime mode.
DB_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
PORT=3060
# Photo storage is not connected to startup. Disposable SeaweedFS tests generate
# their own verified configuration; never copy real S3/R2 credentials into tests.
ITEM_IMAGES_ENABLED=false
