# Local replica set; see README for guarded index preparation before startup.
# Pickup timezone is selected explicitly on each plan, never inferred from TZ/env.
MONGO_URL=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_DB_NAME=giftdb
# Explicit administration tier; independent of NODE_ENV's cookie/runtime mode.
DB_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
PORT=3060
# Photo storage is not connected to startup. Disposable SeaweedFS tests generate
# their own verified configuration; never copy real S3/R2 credentials into tests.
ITEM_IMAGES_ENABLED=false
# B2 owner JSON metadata only; does NOT enable uploads, processing or delivery.
# Leave disabled until the separately approved index/target preparation is complete.
ITEM_IMAGE_METADATA_ENABLED=false
# B3 binary processing/delivery cannot be enabled through deployment env yet.
# Explicit local fixtures inject the pipeline; hosted activation still needs
# separate real-provider approval. F1 R2 configuration has a separate sample.
ITEM_IMAGE_PIPELINE_ENABLED=false
ITEM_IMAGE_R2_ENABLED=false
ITEM_IMAGE_R2_UPLOADS_ENABLED=false
# When enabled, require the verified storage target fingerprint (64 lowercase hex)
# and namespace item-images-development-<32 lowercase hex>. No credentials/URLs here.
# ITEM_IMAGE_STORAGE_TARGET=
# ITEM_IMAGE_NAMESPACE=
# Provisional pilot ceilings; configurable downward only, not launch approval.
# ITEM_IMAGE_QUOTA_DAILY_ATTEMPTS=50
# ITEM_IMAGE_QUOTA_DAILY_SUCCESSES=20
# ITEM_IMAGE_QUOTA_ACCOUNT_BYTES=104857600
# ITEM_IMAGE_QUOTA_CONCURRENT=2
# ITEM_IMAGE_QUOTA_RECORDS=1000

# UX-2B2 private independent owner API: prepare items_owner_created explicitly
# before enabling. Public v2 publishing/media/pickups remain unavailable.
OWNER_LISTINGS_ENABLED=false

# UX-2C1 owner-only photos for independent drafts. Requires OWNER_LISTINGS_ENABLED=true
# and ITEM_IMAGE_METADATA_ENABLED=true; public/requester v2 media remain unavailable.
OWNER_LISTING_PHOTOS_ENABLED=false

# UX-2C2 pickup requests, conversations and scheduling for eligible independent listings.
# Requires OWNER_LISTINGS_ENABLED=true. Publication has its own gate below.
OWNER_LISTING_PICKUPS_ENABLED=false

# UX-2C3 publication, withdrawal and mixed public discovery. Default off.
# Requires OWNER_LISTINGS_ENABLED=true and OWNER_LISTING_PICKUPS_ENABLED=true.
# Hosted photo processing/R2 activation is still independently disabled.
OWNER_LISTING_PUBLICATION_ENABLED=false
