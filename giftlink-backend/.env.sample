# Milestone 3 local replica set; see README for explicit one-time initialization.
MONGO_URL=mongodb://127.0.0.1:27018/?directConnection=true
MONGO_DB_NAME=giftdb
# Explicit administration tier; independent of NODE_ENV's cookie/runtime mode.
DB_ENVIRONMENT=development
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
PORT=3060
