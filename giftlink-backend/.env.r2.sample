# Design/configuration template only. F1 does not authorize real-provider access.
# Ordinary server startup REFUSES R2 or pipeline activation, even with a receipt.
ITEM_IMAGE_METADATA_ENABLED=false
ITEM_IMAGE_PIPELINE_ENABLED=false
ITEM_IMAGE_R2_ENABLED=false
ITEM_IMAGE_R2_UPLOADS_ENABLED=false

# A future separately approved explicit context needs ALL fields below.
# No local receipt or endpoint override is accepted by the R2 entry point.
DB_ENVIRONMENT=staging
MONGO_URL=
MONGO_DB_NAME=
ITEM_IMAGE_R2_ENVIRONMENT=staging
ITEM_IMAGE_R2_ROLE=runtime
ITEM_IMAGE_R2_ACCOUNT_ID=
# Exact https://<32-lowercase-hex-account>.r2.cloudflarestorage.com origin only.
ITEM_IMAGE_R2_ENDPOINT=
ITEM_IMAGE_R2_REGION=auto
ITEM_IMAGE_R2_BUCKET=
# item-images-staging-<32-hex> or item-images-production-<32-hex>, matching tier.
ITEM_IMAGE_R2_NAMESPACE=
ITEM_IMAGE_R2_TARGET=
ITEM_IMAGE_R2_DATABASE_TARGET=
# Credentials belong in approved secure storage, never in source/chat/PRs.
ITEM_IMAGE_R2_ACCESS_KEY_ID=
ITEM_IMAGE_R2_SECRET_ACCESS_KEY=
# Owner-signed, private file; runtime gets only the Ed25519 public key (SPKI hex).
ITEM_IMAGE_R2_APPROVAL_FILE=
ITEM_IMAGE_R2_APPROVAL_PUBLIC_KEY=
# Metadata binding must exactly equal the approved R2 target and namespace.
ITEM_IMAGE_STORAGE_TARGET=
ITEM_IMAGE_NAMESPACE=
# PHOTO_APPROVAL_PRIVATE_KEY is OFFLINE OPERATOR ONLY; never configure it here
# or in the API/Vercel environment. See docs/milestone-6.5f1-r2-architecture.md.
