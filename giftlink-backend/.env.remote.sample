# Template only. Supply URI/credentials securely; never commit a real .env file.
# Standard TCP and SRV URIs are supported. Remote preparation requires verified TLS.
# Inventory writes require a transaction-capable replica set/sharded deployment.
MONGO_URL=
# Explicit application database, not admin/config/local; URI path is not selection.
MONGO_DB_NAME=
# Choose staging or production for the actual target (development is also supported).
DB_ENVIRONMENT=staging
# Runtime mode is separate from database tier. Both staging and production use HTTPS.
NODE_ENV=production
APP_ORIGIN=https://app.example.invalid
SESSION_TTL_SECONDS=28800
PORT=3060
# Pickup timezone is a giver-selected plan field, not an environment setting.
# B2 remains disabled; no binary uploads or storage credentials are needed.
ITEM_IMAGE_METADATA_ENABLED=false
# True is deliberately refused until B4; no R2 credentials belong in B3 tests.
ITEM_IMAGE_PIPELINE_ENABLED=false
# Disabled startup needs only the 12 pre-B2 application indexes; no photo DDL.
# Before explicitly enabling metadata, all four compatible itemImages indexes
# require separately approved guarded preparation. Startup never creates indexes.
# See docs/milestone-6.5b2-photo-metadata.md before any future activation.
