    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.1.2",
    "chai": "^4.3.10",
    "jshint": "2.13.6",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.2",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3"
  }
