  "main": "app.js",
  "engines": { "node": "22.x" },
  "scripts": {
    "test": "mocha --timeout 30000 --recursive test --fail-zero",
    "test:integration": "mocha --timeout 30000 test/integration.test.js test/identity.test.js test/plans.test.js test/items.test.js test/discovery.test.js test/regional-discovery.test.js test/pickups.test.js test/pickup-communication.test.js test/rescheduling.test.js test/item-images.test.js --fail-zero",
    "test:preparation": "mocha --timeout 30000 test/prepare-database.test.js --fail-zero",
    "test:images": "mocha --timeout 30000 test/item-images.test.js --fail-zero",
    "test:images:pipeline": "mocha --timeout 30000 test/item-image-processing.test.js test/item-image-pipeline.test.js --fail-zero",
    "test:images:resources": "node util/benchmark-item-images.js",
    "test:images:recovery": "mocha --timeout 180000 test/item-image-recovery.test.js --fail-zero",
    "images:reconcile": "node util/reconcile-item-images.js",
    "lint": "jshint --config ../.jshintrc app.js app-factory.js index.js runtime.js server.js config.js logger.js models routes services middleware serializers util/import-mongo/index.js util/prepare-database.js util/database-target.js util/verify-region-source.js util/benchmark-item-images.js util/local-maintenance-receipt.js util/local-image-maintenance.js util/reconcile-item-images.js ../deployment/validate-staging-preparation.js test",
    "seed": "node util/import-mongo/index.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:prepare": "node util/prepare-database.js",
    "test:storage": "mocha --timeout 180000 test/item-image-storage.test.js test/item-image-storage-contract.test.js --fail-zero",
    "test:storage:unit": "mocha --timeout 10000 test/item-image-storage.test.js --fail-zero",
    "test:storage:seaweedfs": "mocha --timeout 180000 test/item-image-storage-contract.test.js --fail-zero"
  },
  "keywords": [],
